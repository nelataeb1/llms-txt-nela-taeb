# Optional. Without it the app keeps monitoring data in memory only.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional. Without it section names and descriptions come from heuristics.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional. Set on Vercel so only the scheduler can trigger re-crawls.
CRON_SECRET=
